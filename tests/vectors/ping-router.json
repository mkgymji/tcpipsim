    "events": [
      {
        "step": 0,
        "node": "PC1",
        "event": "arp_queue",
        "detail": "192.168.2.10 není v 192.168.1.0/24 -> výchozí cesta, next hop 192.168.1.1; ARP na bránu, ne na server"
      },
      {
        "step": 1,
        "node": "R1",
        "event": "arp_learn",
        "detail": "192.168.1.10 -> 02:00:00:00:00:01 na G0/0 (z requestu)"
      },
      {
        "step": 2,
        "node": "PC1",
        "event": "arp_learn",
        "detail": "192.168.1.1 -> 02:00:00:00:01:01; odeslání paketu z fronty"
      },
      {
        "step": 3,
        "node": "R1",
        "event": "ip_forward",
        "detail": "TTL 128 -> 127; longest match 192.168.2.0/24 connected G0/1; next hop = 192.168.2.10, MAC neznámá"
      },
      {
        "step": 3,
