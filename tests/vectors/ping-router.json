{
  "format": "tcpipsim-vector/1",
  "id": "ping-router",
  "title": "Ping z PC v 192.168.1.0/24 na server v 192.168.2.0/24 přes router (výchozí brána)",
  "description": "PC1 se ARPem ptá na bránu, ne na server. Router snižuje TTL, mění MAC adresy rámce, IP adresy zůstávají. Server odpovídá s vlastním TTL 64, PC1 vidí TTL 63. Linky jsou přímé (bez switchů), aby vynikla L3 logika.",
  "spec_refs": [
    "docs/spec/model.md",
    "docs/spec/arp.md",
    "docs/spec/ipv4.md",
    "docs/spec/icmp.md"
  ],
  "topology": {
    "nodes": [
      {
        "id": "PC1",
        "type": "pc",
        "ttl_default": 128,
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:01",
            "ip": "192.168.1.10",
            "prefix": 24
          }
        ],
        "gateway": "192.168.1.1"
      },
      {
        "id": "R1",
        "type": "router",
        "ttl_default": 255,
        "interfaces": [
          {
            "name": "G0/0",
            "mac": "02:00:00:00:01:01",
            "ip": "192.168.1.1",
            "prefix": 24
          },
          {
            "name": "G0/1",
            "mac": "02:00:00:00:01:02",
            "ip": "192.168.2.1",
            "prefix": 24
          }
        ]
      },
      {
        "id": "SRV1",
        "type": "server",
        "ttl_default": 64,
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:04",
            "ip": "192.168.2.10",
            "prefix": 24
          }
        ],
        "gateway": "192.168.2.1"
      }
    ],
    "links": [
      {
        "id": "L1",
        "a": {
          "node": "PC1",
          "if": "eth0"
        },
        "b": {
          "node": "R1",
          "if": "G0/0"
        }
      },
      {
        "id": "L2",
        "a": {
          "node": "R1",
          "if": "G0/1"
        },
        "b": {
          "node": "SRV1",
          "if": "eth0"
        }
      }
    ]
  },
  "initial_state": {
    "arp_cache": {
      "PC1": [],
      "R1": [],
      "SRV1": []
    },
    "routing_table": {
      "PC1": [
        {
          "prefix": "192.168.1.0/24",
          "next_hop": null,
          "if": "eth0",
          "type": "connected"
        },
        {
          "prefix": "0.0.0.0/0",
          "next_hop": "192.168.1.1",
          "if": "eth0",
          "type": "default"
        }
      ],
      "SRV1": [
        {
          "prefix": "192.168.2.0/24",
          "next_hop": null,
          "if": "eth0",
          "type": "connected"
        },
        {
          "prefix": "0.0.0.0/0",
          "next_hop": "192.168.2.1",
          "if": "eth0",
          "type": "default"
        }
      ],
      "R1": [
        {
          "prefix": "192.168.1.0/24",
          "next_hop": null,
          "if": "G0/0",
          "type": "connected"
        },
        {
          "prefix": "192.168.1.1/32",
          "next_hop": null,
          "if": "G0/0",
          "type": "local"
        },
        {
          "prefix": "192.168.2.0/24",
          "next_hop": null,
          "if": "G0/1",
          "type": "connected"
        },
        {
          "prefix": "192.168.2.1/32",
          "next_hop": null,
          "if": "G0/1",
          "type": "local"
        }
      ]
    }
  },
  "actions": [
    {
      "time": 0,
      "node": "PC1",
      "command": "ping",
      "args": {
        "dst": "192.168.2.10",
        "count": 1
      }
    }
  ],
  "expected": {
    "transmissions": [
      {
        "n": 1,
        "step": 1,
        "link": "L1",
        "from": "PC1",
        "to": "R1",
        "summary": "ARP request: kdo má 192.168.1.1? Ptá se 192.168.1.10",
        "pdu": {
          "eth": {
            "dst": "ff:ff:ff:ff:ff:ff",
            "src": "02:00:00:00:00:01",
            "ethertype": "0x0806"
          },
          "arp": {
            "op": "request",
            "sha": "02:00:00:00:00:01",
            "spa": "192.168.1.10",
