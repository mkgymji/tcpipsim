      },
      {
        "step": 5,
        "node": "R1",
        "event": "arp_learn",
        "detail": "192.168.2.10 -> 02:00:00:00:00:04 na G0/1; odeslání paketu z fronty"
      },
      {
        "step": 6,
        "node": "SRV1",
        "event": "ip_deliver",
        "detail": "Echo Request pro mě; odpověď na 192.168.1.10 jde přes bránu 192.168.2.1, jejíž MAC už znám"
      },
      {
        "step": 7,
        "node": "R1",
        "event": "ip_forward",
        "detail": "TTL 64 -> 63; longest match 192.168.1.0/24 connected G0/0; MAC 192.168.1.10 známá"
      },
      {
        "step": 8,
        "node": "PC1",
        "event": "ip_deliver",
