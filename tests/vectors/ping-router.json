{
  "format": "tcpipsim-vector/1",
  "id": "ping-router",
  "title": "Ping Alice (192.168.1.0/24) -> Bob (192.168.2.0/24) přes router, přímé kabely",
  "description": "Minimální varianta topologie úrovně 3 (rozhodnutí 39) bez switche, aby vynikla L3 logika. Alice se ARPem ptá na bránu, ne na Boba. Router snižuje TTL, mění MAC adresy rámce, IP adresy zůstávají; paket čeká ve frontě routeru na ARP Boba (rozhodnutí 9). Bob (Windows, TTL 128) odpovídá novým paketem, Alice vidí TTL 127. Plná topologie se switchem je ve vektoru ping-arp-prvni.",
  "level": 3,
  "spec_refs": [
    "docs/spec/model.md",
    "docs/spec/arp.md",
    "docs/spec/ipv4.md",
    "docs/spec/icmp.md",
    "docs/spec/routing.md",
    "docs/spec/vektory.md",
    "docs/rozhodnuti.md bod 9, 39"
  ],
  "topology": {
    "nodes": [
      {
        "id": "PC1",
        "type": "pc",
        "label": "Alice",
        "ttl_default": 128,
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:01",
            "ip": "192.168.1.10",
            "prefix": 24
          }
        ],
        "gateway": "192.168.1.1"
      },
      {
        "id": "R1",
        "type": "router",
        "label": "R1",
        "ttl_default": 255,
        "interfaces": [
          {
            "name": "Gi0/0",
            "mac": "02:00:00:00:01:01",
            "ip": "192.168.1.1",
            "prefix": 24
          },
          {
            "name": "Gi0/1",
            "mac": "02:00:00:00:01:02",
            "ip": "192.168.2.1",
            "prefix": 24
          }
        ]
      },
      {
        "id": "PC2",
        "type": "pc",
        "label": "Bob",
        "ttl_default": 128,
        "interfaces": [
          {
            "name": "eth0",
            "mac": "02:00:00:00:00:02",
            "ip": "192.168.2.20",
            "prefix": 24
          }
        ],
        "gateway": "192.168.2.1"
      }
    ],
    "links": [
      {
        "id": "L1",
        "a": {
          "node": "PC1",
          "if": "eth0"
        },
        "b": {
          "node": "R1",
          "if": "Gi0/0"
        }
      },
      {
        "id": "L2",
        "a": {
          "node": "R1",
          "if": "Gi0/1"
        },
        "b": {
          "node": "PC2",
          "if": "eth0"
        }
      }
    ]
  },
