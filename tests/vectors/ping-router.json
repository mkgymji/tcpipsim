      },
      {
        "n": 5,
        "step": 5,
        "link": "L2",
        "from": "SRV1",
        "to": "R1",
        "summary": "ARP reply: 192.168.2.10 má MAC 02:00:00:00:00:04",
        "pdu": {
          "eth": {
            "dst": "02:00:00:00:01:02",
            "src": "02:00:00:00:00:04",
            "ethertype": "0x0806"
          },
          "arp": {
            "op": "reply",
            "sha": "02:00:00:00:00:04",
            "spa": "192.168.2.10",
            "tha": "02:00:00:00:01:02",
            "tpa": "192.168.2.1"
          },
          "frame_len": 60
        }
      },
      {
        "n": 6,
        "step": 6,
        "link": "L2",
        "from": "R1",
        "to": "SRV1",
        "summary": "ICMP Echo Request 192.168.1.10 -> 192.168.2.10 (nové MAC, stejné IP, TTL 127)",
        "pdu": {
          "eth": {
            "dst": "02:00:00:00:00:04",
