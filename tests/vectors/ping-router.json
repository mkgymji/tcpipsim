        "link": "L1",
        "from": "PC1",
        "to": "R1",
        "summary": "ICMP Echo Request 192.168.1.10 -> 192.168.2.10 (cílová MAC = brána)",
        "pdu": {
          "eth": {
            "dst": "02:00:00:00:01:01",
            "src": "02:00:00:00:00:01",
            "ethertype": "0x0800"
          },
          "ip": {
            "src": "192.168.1.10",
            "dst": "192.168.2.10",
